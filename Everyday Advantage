  <style>
    :root {
      color-scheme: light dark;
      --bg: #0c0c0d;
      --panel: #151516;
      --panel-2: #1d1c1c;
      --text: #f8f5f0;
      --muted: #beb7ad;
      --faint: #8e8880;
      --line: #343130;
      --accent: #d5ae67;
      --accent-ink: #171109;
      --red: #9c1d24;
      --paper: #f3eee6;
      --shadow: 0 18px 55px rgba(0,0,0,.26);
    }
    @media (prefers-color-scheme: light) {
      :root {
        --bg: #101011;
        --panel: #181819;
        --panel-2: #232121;
        --text: #fbf7f0;
        --muted: #c6beb4;
        --faint: #9a9289;
        --line: #393534;
        --accent: #d7ae63;
        --accent-ink: #171109;
        --red: #9f1e27;
        --paper: #f4efe8;
        --shadow: 0 18px 55px rgba(0,0,0,.34);
      }
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font-family: "DM Sans", sans-serif;
      -webkit-font-smoothing: antialiased;
    }
    button, input { font: inherit; }
    button, a { -webkit-tap-highlight-color: transparent; }
    a { color: inherit; }
    img { display: block; max-width: 100%; }
    .announcement {
      min-height: 36px;
      display: grid;
      place-items: center;
      padding: 8px 18px;
      background: var(--accent);
      color: var(--accent-ink);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: .07em;
      text-align: center;
    }
    .site-nav {
      height: 72px;
      max-width: 1220px;
      margin: 0 auto;
      padding: 0 24px;
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: 28px;
      border-bottom: 1px solid var(--line);
    }
    .nav-links { display: flex; gap: 30px; align-items: center; }
    .nav-links a {
      text-decoration: none;
      font-size: 14px;
      color: var(--muted);
      transition: color .2s ease;
    }
    .nav-links a:hover, .nav-links a:focus-visible { color: var(--text); }
    .nav-mark {
      font-family: "Playfair Display", serif;
      justify-self: center;
      font-size: 17px;
      letter-spacing: .08em;
      color: var(--text);
      text-transform: uppercase;
    }
    .nav-actions { display: flex; justify-content: flex-end; gap: 8px; }
    .icon-btn, .menu-btn {
      border: 0;
      background: transparent;
      color: var(--text);
      min-width: 42px;
      min-height: 42px;
      display: grid;
      place-items: center;
      cursor: pointer;
      text-decoration: none;
    }
    .icon-btn:hover, .menu-btn:hover { color: var(--accent); }
    .menu-btn { display: none; }
    .mobile-drawer { display: none; }
    .search-panel {
      max-width: 1220px;
      margin: 0 auto;
      padding: 0 24px;
      display: none;
    }
    .search-panel.open { display: block; }
    .search-inner { overflow: visible; }
    .search-box {
      margin: 16px 0 20px;
      display: flex;
      gap: 12px;
      align-items: center;
      padding: 12px 16px;
      border: 1px solid var(--line);
      background: var(--panel);
    }
    .search-box input {
      flex: 1;
      border: 0;
      outline: 0;
      background: transparent;
      color: var(--text);
      min-width: 0;
    }
    .hero {
      max-width: 1220px;
      margin: 0 auto;
      padding: 56px 24px 42px;
      display: grid;
      grid-template-columns: minmax(0,.88fr) minmax(440px,1.12fr);
      gap: clamp(34px, 6vw, 84px);
      align-items: center;
    }
    .hero-copy { padding-left: clamp(0px, 3vw, 28px); }
    .eyebrow {
      margin: 0 0 18px;
      color: var(--accent);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: .16em;
      text-transform: uppercase;
    }
    h1, h2, h3 { font-family: "Playfair Display", serif; }
    h1 {
      max-width: 620px;
      margin: 0;
      font-size: clamp(46px, 6vw, 78px);
      font-weight: 500;
      line-height: .98;
      letter-spacing: -.035em;
    }
    .hero-copy > p:not(.eyebrow) {
      max-width: 500px;
      margin: 24px 0 30px;
      font-size: clamp(16px, 2vw, 19px);
      line-height: 1.65;
      color: var(--muted);
    }
    .cta-row { display: flex; flex-wrap: wrap; gap: 12px; }
    .btn {
      min-height: 48px;
      padding: 0 22px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      border: 1px solid var(--accent);
      text-decoration: none;
      font-weight: 700;
      font-size: 14px;
      transition: background .2s ease, color .2s ease;
    }
    .btn-primary { background: var(--accent); color: var(--accent-ink); }
    .btn-primary:hover { background: transparent; color: var(--accent); }
    .btn-secondary { color: var(--text); border-color: var(--line); }
    .btn-secondary:hover { border-color: var(--accent); color: var(--accent); }
    .hero-visual { position: relative; padding: 0 22px 22px 0; }
    .hero-visual::after {
      content: "";
      position: absolute;
      right: 0;
      bottom: 0;
      width: 58%;
      height: 62%;
      background: var(--red);
      z-index: -1;
    }
    .hero-visual img {
      width: 100%;
      aspect-ratio: 1 / .86;
      object-fit: cover;
      object-position: center 42%;
      box-shadow: var(--shadow);
    }
    .hero-note {
      position: absolute;
      left: -22px;
      bottom: 52px;
      width: 182px;
      padding: 16px 18px;
      background: var(--paper);
      color: #191714;
      box-shadow: var(--shadow);
    }
    .hero-note strong { display: block; font-size: 14px; margin-bottom: 4px; }
    .hero-note span { font-size: 12px; color: #6f675e; }
    .trust-row {
      max-width: 1172px;
      margin: 0 auto;
      padding: 20px 24px 48px;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      border-bottom: 1px solid var(--line);
    }
    .trust-item {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      color: var(--muted);
      font-size: 13px;
    }
    .trust-item + .trust-item { border-left: 1px solid var(--line); }
    .section { max-width: 1220px; margin: 0 auto; padding: 84px 24px; }
    .section-heading {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 24px;
      margin-bottom: 28px;
    }
    .section-heading h2 {
      margin: 0;
      font-size: clamp(32px, 4vw, 48px);
      font-weight: 500;
      letter-spacing: -.025em;
    }
    .section-heading p { max-width: 430px; margin: 0; color: var(--muted); line-height: 1.6; }
    .category-grid {
      display: grid;
      grid-template-columns: 1fr 1fr 1.3fr;
      gap: 16px;
    }
    .category-card {
      position: relative;
      min-height: 390px;
      overflow: hidden;
      color: #fff;
      text-decoration: none;
      isolation: isolate;
    }
    .category-card img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform .45s ease;
      z-index: -2;
    }
    .category-card::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, transparent 32%, rgba(0,0,0,.76));
      z-index: -1;
    }
    .category-card:hover img { transform: scale(1.025); }
    .category-copy { position: absolute; left: 24px; right: 24px; bottom: 24px; }
    .category-copy span { font-size: 12px; opacity: .84; }
    .category-copy h3 { margin: 5px 0 0; font-size: 29px; font-weight: 500; }
    .featured { background: var(--panel); }
    .featured .section { padding-top: 76px; }
    .filters { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 18px; }
    .filter-btn {
      border: 1px solid var(--line);
      background: transparent;
      color: var(--muted);
      min-height: 38px;
      padding: 0 16px;
      cursor: pointer;
    }
    .filter-btn.active { border-color: var(--accent); color: var(--accent); }
    .results-line { margin: 0 0 26px; color: var(--faint); font-size: 13px; }
    .product-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px; }
    .product-card { background: var(--bg); display: grid; grid-template-columns: .92fr 1.08fr; min-height: 360px; }
    .product-image { min-height: 360px; overflow: hidden; background: #eee; }
    .product-image img { width: 100%; height: 100%; object-fit: cover; transition: transform .35s ease; }
    .product-image:hover img { transform: scale(1.02); }
    .product-info { padding: 30px; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; }
    .tag { margin: 0 0 10px; color: var(--accent); font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
    .product-info h3 { margin: 0; font-size: 24px; font-weight: 500; line-height: 1.14; }
    .product-info .price { margin: 15px 0 18px; font-weight: 700; font-size: 18px; }
    .product-info .desc { color: var(--muted); line-height: 1.55; font-size: 14px; margin: 0 0 22px; }
    .text-btn { border: 0; border-bottom: 1px solid var(--accent); padding: 0 0 5px; background: none; color: var(--accent); font-weight: 700; cursor: pointer; text-decoration: none; }
    .story-strip {
      max-width: 1172px;
      margin: 80px auto;
      min-height: 300px;
      display: grid;
      grid-template-columns: 1.2fr .8fr;
      background: var(--red);
      color: #fff;
    }
    .story-image img { width: 100%; height: 100%; min-height: 300px; object-fit: cover; object-position: center 53%; }
    .story-copy { padding: 50px; display: flex; flex-direction: column; justify-content: center; }
    .story-copy h2 { margin: 0 0 16px; font-size: clamp(32px, 4vw, 46px); font-weight: 500; line-height: 1.05; }
    .story-copy p { margin: 0; line-height: 1.65; color: rgba(255,255,255,.83); }
    footer {
      max-width: 1172px;
      margin: 0 auto;
      padding: 30px 24px 44px;
      border-top: 1px solid var(--line);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      color: var(--faint);
      font-size: 12px;
    }
    footer nav { display: flex; flex-wrap: wrap; gap: 18px; }
    footer a { text-decoration: none; }
    footer a:hover { color: var(--text); }
    .empty-state { display: none; color: var(--muted); padding: 40px 0; }
    :focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
    @media (max-width: 900px) {
      .site-nav { grid-template-columns: auto 1fr auto; }
      .menu-btn { display: grid; }
      .nav-links { display: none; }
      .nav-mark { justify-self: start; font-size: 14px; }
      .mobile-drawer {
        display: none;
        padding: 12px 24px 22px;
        border-bottom: 1px solid var(--line);
        background: var(--bg);
      }
      .mobile-drawer.open { display: grid; gap: 6px; }
      .mobile-drawer a { padding: 12px 0; text-decoration: none; border-bottom: 1px solid var(--line); }
      .hero { grid-template-columns: 1fr; padding-top: 44px; }
      .hero-copy { padding-left: 0; max-width: 650px; }
      .hero-visual { width: min(680px, 94%); justify-self: end; }
      .category-grid { grid-template-columns: 1fr 1fr; }
      .category-card:last-child { grid-column: 1 / -1; min-height: 330px; }
      .product-card { grid-template-columns: 1fr; }
      .product-image { min-height: 300px; }
      .story-strip { margin-left: 24px; margin-right: 24px; }
    }
    @media (max-width: 640px) {
      .site-nav { height: 62px; padding: 0 16px; gap: 8px; }
      .nav-mark { font-size: 12px; letter-spacing: .06em; }
      .search-panel { padding: 0 16px; }
      .hero { padding: 36px 16px 28px; gap: 34px; }
      h1 { font-size: clamp(42px, 14vw, 60px); }
      .hero-visual { width: calc(100% - 10px); padding: 0 12px 12px 0; }
      .hero-note { left: -10px; bottom: 26px; width: 158px; padding: 12px 14px; }
      .trust-row { grid-template-columns: 1fr; gap: 0; padding: 16px 16px 34px; }
      .trust-item { justify-content: flex-start; padding: 12px 8px; }
      .trust-item + .trust-item { border-left: 0; border-top: 1px solid var(--line); }
      .section { padding: 62px 16px; }
      .section-heading { align-items: flex-start; flex-direction: column; gap: 10px; }
      .category-grid { grid-template-columns: 1fr; }
      .category-card, .category-card:last-child { min-height: 360px; grid-column: auto; }
      .product-grid { grid-template-columns: 1fr; }
      .product-card { min-height: 0; }
      .product-image { min-height: 330px; }
      .product-info { padding: 26px 22px 30px; }
      .story-strip { margin: 44px 16px; grid-template-columns: 1fr; }
      .story-copy { padding: 34px 24px 38px; }
      footer { margin: 0 16px; padding-left: 0; padding-right: 0; flex-direction: column; align-items: flex-start; }
    }
    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      *, *::before, *::after { transition: none !important; }
    }
  </style>
</head>
